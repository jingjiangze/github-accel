    "https://raw.githubusercontent.com/ittuann/GitHub-IP-hosts/main/hosts"
  ],
  "dns_over_proxy": {
    "enabled": true,
    "proxy": "http://127.0.0.1:7897",
    "doh": "https://cloudflare-dns.com/dns-query?name=DOMAIN"
  },
  "probe": {
    "budget_ms": 8000,
    "concurrency": 8,
    "win_ratio": 0.85,
    "retries": 3,
    "max_entries": 30,
    "ok_codes": [200, 206, 301, 302, 404],
    "min_bytes": 1
  },
  "proxy_ttl_s": 60,
  "proxy_probe_concurrency": 4,
  "proxy_history_samples": 12,
  "proxy_score_weights": { "stability": 30, "speed_p50": 25, "speed_p10": 15, "latency": 15, "fail_rate": 10, "freshness": 5 },
  "proxy_cooldown": { "tier1_fails": 3, "tier1_ms": 1800000, "tier2_fails": 5, "tier2_ms": 7200000, "tier3_fails": 8, "tier3_ms": 86400000 },
  "proxy_freshness_ms": 3600000,
  "proxy_race_diversity": true,
  "fake_ip_ranges4": ["198.18.0.0/16"],
  "fake_ip_ranges6": ["fdfe:dcba:9876::/64"],
  "fake_ip_probe_domain": "www.example.com",
  "race": {
    "max": 3,
    "first_byte_ms": 4000,
    "speed_limit_bps": 32768,
    "speed_time_ms": 5000,
    "retries_per_entry": 2,
    "max_time_s": 900,
    "wall_ms": 300000
  },
  "clone": {
    "same_retry": 2,
    "low_speed_limit": 1024,
    "low_speed_time": 20
  },
  "domains": {
