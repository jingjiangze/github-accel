    "gist.github.com": { "canary": "/", "expect": [200] },
    "github.com": { "canary": "/", "expect": [200], "strict": true, "min_bytes": 8192, "max_ms": 4000 },
    "cdn.jsdelivr.net": { "canary": "/npm/react/package.json" },
    "registry.npmjs.org": { "canary": "/react" }
